# NCBI API key — register free at https://www.ncbi.nlm.nih.gov/account/
# Without a key: 3 requests/sec limit
# With a key:   8 requests/sec (margin below NCBI's 10 req/s ceiling)
#
# How to provide this value (choose one):
#   Local dev      — copy this file to .env and fill in the key
#   Web server     — set as an OS environment variable (systemd EnvironmentFile=,
#                    Docker `--env NCBI_API_KEY=...`, Cloud Run --set-secrets, etc.)
#   Claude Desktop — add to the "env" block in claude_desktop_config.json
NCBI_API_KEY=

# HTTP server port — enables HTTP / Streamable HTTP transport when set.
# Leave blank for stdio mode (default for local Claude Desktop use).
# Cloud Run sets PORT=8080 automatically; you do not need to set this yourself.
PORT=

# OAuth 2.0 settings — HTTP mode only (not used in stdio mode).
# In HTTP mode /mcp requires a Bearer JWT issued by the authorization server
# (WorkOS AuthKit), and the server exits at startup if OAUTH_ISSUER,
# OAUTH_JWKS_URL or MCP_RESOURCE_URL is empty.
#
# OAUTH_ISSUER / OAUTH_JWKS_URL — copy `issuer` / `jwks_uri` from
#   https://<your-authkit-domain>/.well-known/oauth-authorization-server
OAUTH_ISSUER=
OAUTH_JWKS_URL=

# Public URL of the MCP endpoint, e.g.
#   https://pubmed-mcp-PROJECT_NUMBER.asia-northeast1.run.app/mcp
# Must exactly match the URL registered in MCP clients and the Resource
# Indicator in WorkOS. Tokens are accepted only if their `aud` equals it.
MCP_RESOURCE_URL=

# Comma-separated token `sub` values (WorkOS user IDs) allowed to use /mcp.
# Empty = any user who can obtain a valid token is allowed, and nothing is
# logged. Rejected subjects are logged as "[auth] forbidden subject: ...",
# so set a placeholder value first to find your own ID.
ALLOWED_SUBJECTS=
