# NCBI API key — register free at https://www.ncbi.nlm.nih.gov/account/
# Without a key: 3 requests/sec limit
# With a key:   9 requests/sec (safety margin below NCBI's 10 req/s ceiling)
#
# How to provide this value (choose one):
#   Local dev      — copy this file to .env and fill in the key
#   Web server     — set as an OS environment variable (systemd EnvironmentFile=,
#                    Docker `--env NCBI_API_KEY=...`, Cloud Run --set-env-vars, etc.)
#   Claude Desktop — add to the "env" block in claude_desktop_config.json
NCBI_API_KEY=

# HTTP server port — enables HTTP / Streamable HTTP transport when set.
# Leave blank for stdio mode (default for local Claude Desktop use).
# Cloud Run sets PORT=8080 automatically; you do not need to set this yourself.
PORT=
